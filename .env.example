[TEMPLATE]
# ==============================================================================
# LLM PROVIDER — bring your own API key (production-ready backend)
# ==============================================================================
# The IDE and its agents run against the provider below. No Kaggle/Colab tunnel
# needed: agents call the provider's HTTP API directly with your key.
#
# Set LLM_PROVIDER to one of: openai, anthropic, gemini, groq, openrouter,
# mistral, together, xai, deepseek, ollama (local), or a custom name for any
# OpenAI-compatible endpoint (then also set LLM_BASE_URL + LLM_MODEL).
#
# If LLM_PROVIDER is left empty, the first provider below that has an API key
# set in the environment wins; if no key is set anywhere, local Ollama is used.
#
# Examples (uncomment ONE provider block and fill in your key):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key
# LLM_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# LLM_MODEL=claude-3-5-sonnet-latest
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza-your-key
# LLM_MODEL=gemini-1.5-flash
#
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-key
#
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Optional embedding model (defaults: text-embedding-3-small / text-embedding-004)
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# Legacy: Kaggle/Colab remote GPU (optional — kept for backward compatibility)
# ==============================================================================
# Kaggle Credentials (Example template)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Colab Settings
COLAB_RUNTIME=GPU

# Tunnel & Remote GPU Endpoint
TUNNEL_TYPE=cloudflare
TUNNEL_PORT=8000
KAGGLE_ENDPOINT=https://your-tunnel.trycloudflare.com
REMOTE_GPU_ENDPOINT=https://your-tunnel.trycloudflare.com

# Models
MODEL1=qwen2.5-coder:3b
MODEL2=qwen2.5-coder:3b
MODEL3=qwen2.5-coder:3b
MODEL4=llama3.2:3b
MODEL5=llama3.2:3b
MODEL6=nomic-embed-text
