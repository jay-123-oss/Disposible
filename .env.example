# Kaggle Credentials (Example template)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Colab Settings
COLAB_RUNTIME=GPU

# Tunnel & Remote GPU Endpoint
TUNNEL_TYPE=cloudflare
TUNNEL_PORT=8000
KAGGLE_ENDPOINT=https://your-tunnel.trycloudflare.com
REMOTE_GPU_ENDPOINT=https://your-tunnel.trycloudflare.com

# Models
MODEL1=qwen2.5-coder:3b
MODEL2=qwen2.5-coder:3b
MODEL3=qwen2.5-coder:3b
MODEL4=llama3.2:3b
MODEL5=llama3.2:3b
MODEL6=nomic-embed-text
